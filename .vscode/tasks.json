{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "CMake Configure Debug",
			"type": "shell",
			"command": "cmake",
			"args": [
				"-S", ".",
				"-B", "./builds/build-debug",
				"-DCMAKE_BUILD_TYPE=Debug"
			],
			"group": {
				"kind": "build",
				"isDefault": true
			  }
		},
		{
			"label": "CMake Build Debug",
			"type": "shell",
			"command": "cmake",
			"args": [
				"--build", "./builds/build-debug",
			],
			"group": {
				"kind": "build",
				"isDefault": true
			  }
		},
		{
			"label": "Run Debug",
			"type": "shell",
			"command": "./builds/build-debug/httpservercpp"
		}
	]
}